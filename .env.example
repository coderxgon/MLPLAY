# ============================================================
# MLPlay — environment configuration (copy to .env or set in Render)
# ============================================================

# Paste your Telegram bot token from @BotFather.
# Leave EMPTY to set it later from the admin panel (Customize -> General).
BOT_TOKEN=

# Password to log into the web admin panel (http://<your-app>/admin)
ADMIN_PASSWORD=MLPlay-Admin-2026

# Your public HTTPS URL (needed for Telegram Mini App + deep links)
# On Render this is e.g. https://mlplay.onrender.com
WEBAPP_URL=

# Database. Defaults to SQLite file in ./data.
# For a persistent 24/7 deployment use a managed Postgres (recommended):
# DATABASE_URL=postgresql+psycopg2://user:pass@host/db
DATABASE_URL=

# Set 1 to allow the Mini App API in development without Telegram signature
# (for local testing of the web pages). NEVER use 1 in production.
DEBUG_WEBAPP_DEV=0